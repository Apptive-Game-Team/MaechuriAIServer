# ===========================================
# 환경변수 설정 파일 템플릿
# 이 파일을 복사하여 .env로 저장 후 사용
# cp .env.example .env
# ===========================================

# Gemini API 설정
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL 설정
# 기본 설정은 로컬 개발 환경(docker-compose)에 맞춤
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=maechuri_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432